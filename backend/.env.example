# Copy this file to .env in backend/ and add your own key locally.
# backend/.env is ignored by Git. Never put this key in Flutter or Android.
PORT=3000
# Select `openai` or `ollama`. Ollama uses only the local service by default.
AI_PROVIDER=openai
# Only required when AI_PROVIDER=openai. Obtain your own key from the OpenAI API dashboard.
OPENAI_API_KEY=replace-with-a-server-side-key
# Must be a model available to your API account. This model supports Responses + Structured Outputs.
OPENAI_MODEL=gpt-5.6-terra
# Used only when AI_PROVIDER=ollama. No API key or cloud sign-in is needed for local inference.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Total context shared by system prompt, resume, and generated feedback.
OLLAMA_NUM_CTX=8192
# Local models can take longer on first load; request timeout defaults to 3 minutes.
OLLAMA_TIMEOUT_MS=180000
# Only needed for Flutter Web; native Android emulator requests do not use CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5000
